# =============================================================================
# BACKEND — desarrollo local (copiar a back/.env)
# Producción 4-VM: usar /opt/muni_union/.env.backend (ver deploy/.env.backend.example)
# =============================================================================

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO
DB_NAME=registro_muni_union
DB_SSL=false

# ── Seguridad JWT (valores distintos; generar con: openssl rand -base64 64) ───
JWT_SECRET=CAMBIAR_CLAVE_ALEATORIA_MIN_64_CARACTERES
REFRESH_TOKEN_SECRET=CAMBIAR_OTRA_CLAVE_DIFERENTE_MIN_64_CARACTERES

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS (origen del front; varios orígenes separados por coma) ───────────────
FRONTEND_URL=http://localhost:3000

# ── Opcionales ────────────────────────────────────────────────────────────────
# AUDIT_RETENTION_DAYS=730
# LOG_LEVEL=debug
# LOGOS_DIR=/ruta/absoluta/uploads/configuracion/logos
