# =============================================================================
# SISTEMA DE REGISTRO CIVIL — Municipalidad Distrital de La Unión
# Archivo de configuración de entorno — BACKEND
# Copiar como .env y completar los valores antes de iniciar el servidor.
# =============================================================================

# ── Base de Datos ─────────────────────────────────────────────────────────────
DB_HOST=localhost            # IP o hostname del servidor PostgreSQL
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO
DB_NAME=muni_union
DB_SSL=false                 # true si la BD usa SSL (ej. Neon.tech en la nube)

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 64
JWT_SECRET=CAMBIAR_CLAVE_ALEATORIA_MIN_64_CARACTERES
REFRESH_TOKEN_SECRET=CAMBIAR_OTRA_CLAVE_DIFERENTE_MIN_64_CARACTERES

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development         # development | production

# ── Frontend (CORS) ───────────────────────────────────────────────────────────
# Separar por comas si hay múltiples orígenes (dev + prod)
FRONTEND_URL=http://localhost:3000
