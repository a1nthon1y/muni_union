# =============================================================================
# Plantilla unificada (referencia / docker-compose local en raíz)
#
# Desarrollo:
#   - Backend: variables en back/.env (ver back/.env.example)
#   - Frontend: front/.env.local con NEXT_PUBLIC_API_URL
#
# Producción 4-VM:
#   - deploy/.env.backend.example  → /opt/muni_union/.env.backend
#   - deploy/.env.frontend.example → /opt/muni_union/.env.frontend
# =============================================================================

# ── Base de datos (stack docker-compose.yml en raíz) ───────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CAMBIAR_CONTRASENA_FUERTE
DB_NAME=registro_muni_union
DB_SSL=false

JWT_SECRET=GENERAR_SECRETO_ALEATORIO_64_BYTES
REFRESH_TOKEN_SECRET=GENERAR_OTRO_SECRETO_DIFERENTE_64_BYTES

PORT=4000
NODE_ENV=production
FRONTEND_URL=http://localhost

AUDIT_RETENTION_DAYS=730

NEXT_PUBLIC_API_URL=http://localhost/api

# Solo docker-compose local (nginx en contenedor):
# PUBLIC_DOMAIN=verificar.ejemplo.gob.pe
# INTERNAL_DOMAIN=192.168.1.100
