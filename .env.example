# ─────────────────────────────────────────────────────────────────────
# VARIABLES DE ENTORNO — copiar a .env y completar antes de desplegar
#
# Generar secretos seguros (ejecutar en terminal):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────

# ── Base de datos ──────────────────────────────────────────────────
# Producción on-premise (servidor en las oficinas):
DB_HOST=localhost          # o "db" si usas docker-compose
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CAMBIAR_CONTRASENA_FUERTE
DB_NAME=registro_muni_union
DB_SSL=false               # true solo si la BD está en la nube (Neon, RDS, etc.)

# ── Seguridad JWT ──────────────────────────────────────────────────
# OBLIGATORIO: generar con el comando de arriba (mínimo 64 bytes)
JWT_SECRET=GENERAR_SECRETO_ALEATORIO_64_BYTES
REFRESH_TOKEN_SECRET=GENERAR_OTRO_SECRETO_DIFERENTE_64_BYTES

# ── Servidor ───────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production        # NUNCA dejar "development" en producción

# ── CORS — URL del frontend ────────────────────────────────────────
# En producción: IP o dominio real del servidor (sin barra final)
# Ej: http://192.168.1.100  o  https://registro.munilaUnion.gob.pe
FRONTEND_URL=http://IP_SERVIDOR

# ── Auditoría ─────────────────────────────────────────────────────
# Días de retención del log de auditoría (defecto: 730 = 2 años)
# Reducir si el espacio en disco es limitado (ej. 365 = 1 año)
AUDIT_RETENTION_DAYS=730

# ── Frontend (Next.js) ─────────────────────────────────────────────
# URL pública de la API — la que ve el navegador del usuario
NEXT_PUBLIC_API_URL=http://IP_SERVIDOR/api
